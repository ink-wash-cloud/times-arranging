<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_row_bg"
    android:paddingLeft="9dp"
    android:paddingRight="9dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/row_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○"
        android:textSize="14sp"
        android:textColor="#B9A7E8"
        android:paddingRight="8dp" />

    <TextView
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#4B4249"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/row_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#8B7F86"
        android:paddingLeft="6dp"
        android:visibility="gone" />

    <!-- ✕：只从桌面清掉这一行，不改数据 -->
    <TextView
        android:id="@+id/row_dismiss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✕"
        android:textSize="13sp"
        android:textColor="#B9A7B0"
        android:paddingLeft="8dp"
        android:paddingRight="2dp" />
</LinearLayout>
